cache/

# 日志
*.log

# 开发调试脚本（一次性探针、浏览器 profile）
.scratch/

# 用户自己导入的字体文件
fonts/*
!fonts/.gitkeep

node_modules/
npm-debug.log*
.DS_Store
Thumbs.db
*.tmp

# 运行时缓存（作者信息等，自动生成）
.cache/

# 打包产物与临时缓存
dist/
build/.tmp/
